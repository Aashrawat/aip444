# Required — OpenRouter for all LLM calls
OPENROUTER_API_KEY=sk-or-...

# Required — Tavily for web search tool
TAVILY_API_KEY=tvly-...

# Optional — model id on OpenRouter (must support tools + structured outputs)
# Avoid openrouter/free for multi-step tool calling.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional — debug logging to stderr (also set with --verbose)
# LOG_LEVEL=debug
